@model FitForge.Models.MaxTestVM
@{
  ViewData["Title"]="Test Your Max"; ViewData["Page"]="Skills";
  int? highlightId = ViewData["HighlightExerciseId"] as int?;
}

<div class="page-header">
  <div><div class="eyebrow">MAX EFFORT</div><h1 class="page-title">Test Your Max</h1></div>
  <a href="/Skills/Index" class="btn btn-outline">← Back to Skills</a>
</div>
<p class="text-muted mb-2">Log a max attempt for any exercise — no workout session needed. Updates your PRs and any skills that need it.</p>

@if(Model.SkillExercises.Count > 0){
  <div class="section-title mt-2 mb-1">For Your Skills</div>
  @foreach(var item in Model.SkillExercises){
    <div class="card mb-1" id="mt-card-@item.ExerciseId" style="border:1px solid var(--line)">
      <div style="display:flex;gap:12px;align-items:center;cursor:pointer" onclick="toggleTest(@item.ExerciseId)">
        <div style="width:48px;height:48px;border-radius:10px;overflow:hidden;background:var(--bg-soft);flex-shrink:0;display:flex;align-items:center;justify-content:center">
          <img src="/images/exercises/@(item.ExerciseId).gif" style="width:100%;height:100%;object-fit:cover"
               onerror="this.onerror=null;this.src='/images/exercises/@(item.ExerciseId).svg';this.onerror=function(){this.style.display='none';this.nextElementSibling.style.display='flex';}"/>
          <span style="display:none;font-size:20px">🏋️</span>
        </div>
        <div style="flex:1">
          <div style="font-weight:600;font-size:14.5px">@item.ExerciseName</div>
          <div class="text-muted" style="font-size:11.5px">@item.SkillName · needs @item.RequiredReps reps</div>
          <div class="text-muted" id="mt-best-@item.ExerciseId" style="font-size:11.5px">@(item.BestReps > 0 ? $"best {item.BestReps} reps" : "no attempts yet")</div>
        </div>
        <span class="text-muted">›</span>
      </div>

      <div id="mt-test-@item.ExerciseId" style="display:none;margin-top:14px;padding-top:14px;border-top:1px solid var(--line)">
        <div style="display:flex;justify-content:center;align-items:center;gap:24px;margin-bottom:6px">
          <button onclick="stepReps(@item.ExerciseId,-1)" style="width:36px;height:36px;border-radius:50%;background:var(--bg-soft);border:none;color:var(--chalk);font-size:16px">−</button>
          <div id="mt-reps-@item.ExerciseId" style="font-size:28px;font-weight:700;color:var(--accent);min-width:40px;text-align:center">0</div>
          <button onclick="stepReps(@item.ExerciseId,1)" style="width:36px;height:36px;border-radius:50%;background:var(--bg-soft);border:none;color:var(--chalk);font-size:16px">+</button>
        </div>
        <div class="text-muted" style="text-align:center;font-size:11px;margin-bottom:12px">MAX REPS ACHIEVED</div>
        <button class="btn btn-solid w-100 mb-1" onclick="submitMaxTest(@item.ExerciseId,false)">✓ Submit Test</button>
        <button class="btn btn-outline w-100" onclick="showAttempts(@item.ExerciseId)">Show past attempts</button>
        <div id="mt-attempts-@item.ExerciseId" style="display:none;margin-top:6px"></div>
      </div>
    </div>
  }
}

<div class="section-title mt-2 mb-1">Gym Lifts</div>
@foreach(var item in Model.GymLifts){
  bool needsWeight = item.TrackingMode == "reps_weight";
  string bestText = "no attempts yet";
  if(item.BestReps > 0 || item.BestWeightKg.HasValue){
    var bits = new List<string>();
    if(item.BestReps > 0) bits.Add(item.BestReps + " reps");
    if(item.BestWeightKg.HasValue) bits.Add(item.BestWeightKg + "kg");
    bestText = "best " + string.Join(" @ ", bits);
  }
  <div class="card mb-1" id="mt-card-@item.ExerciseId" style="border:1px solid var(--line)">
    <div style="display:flex;gap:12px;align-items:center;cursor:pointer" onclick="toggleTest(@item.ExerciseId)">
      <div style="width:48px;height:48px;border-radius:10px;overflow:hidden;background:var(--bg-soft);flex-shrink:0;display:flex;align-items:center;justify-content:center">
        <img src="/images/exercises/@(item.ExerciseId).gif" style="width:100%;height:100%;object-fit:cover"
             onerror="this.onerror=null;this.src='/images/exercises/@(item.ExerciseId).svg';this.onerror=function(){this.style.display='none';this.nextElementSibling.style.display='flex';}"/>
        <span style="display:none;font-size:20px">🏋️</span>
      </div>
      <div style="flex:1">
        <div style="font-weight:600;font-size:14.5px">@item.ExerciseName</div>
        <div class="text-muted" id="mt-best-@item.ExerciseId" style="font-size:11.5px">@bestText</div>
      </div>
      <span class="text-muted">›</span>
    </div>

    <div id="mt-test-@item.ExerciseId" style="display:none;margin-top:14px;padding-top:14px;border-top:1px solid var(--line)">
      <div style="display:flex;justify-content:center;align-items:center;gap:24px;margin-bottom:6px">
        <button onclick="stepReps(@item.ExerciseId,-1)" style="width:36px;height:36px;border-radius:50%;background:var(--bg-soft);border:none;color:var(--chalk);font-size:16px">−</button>
        <div id="mt-reps-@item.ExerciseId" style="font-size:28px;font-weight:700;color:var(--accent);min-width:40px;text-align:center">0</div>
        <button onclick="stepReps(@item.ExerciseId,1)" style="width:36px;height:36px;border-radius:50%;background:var(--bg-soft);border:none;color:var(--chalk);font-size:16px">+</button>
      </div>
      <div class="text-muted" style="text-align:center;font-size:11px;margin-bottom:12px">MAX REPS ACHIEVED</div>
      @if(needsWeight){
        <input type="number" id="mt-weight-@item.ExerciseId" class="form-input mb-1" placeholder="Weight (kg)" step="0.5" min="0"/>
      }
      <button class="btn btn-solid w-100 mb-1" onclick="submitMaxTest(@item.ExerciseId,@(needsWeight ? "true" : "false"))">✓ Submit Test</button>
      <button class="btn btn-outline w-100" onclick="showAttempts(@item.ExerciseId)">Show past attempts</button>
      <div id="mt-attempts-@item.ExerciseId" style="display:none;margin-top:6px"></div>
    </div>
  </div>
}

@section Scripts {
<script>
var FF_UID = @(Context.Session.GetInt32("uid") ?? 0);
var HIGHLIGHT_ID = @(highlightId.HasValue ? highlightId.Value.ToString() : "null");

function toggleTest(exId){
  var row = document.getElementById('mt-test-' + exId);
  if(!row) return;
  var attempts = document.getElementById('mt-attempts-' + exId);
  if(attempts) attempts.style.display = 'none';
  row.style.display = row.style.display === 'block' ? 'none' : 'block';
}

function stepReps(exId, delta){
  var el = document.getElementById('mt-reps-' + exId);
  var v = Math.max(0, parseInt(el.textContent) + delta);
  el.textContent = v;
}

function submitMaxTest(exId, needsWeight){
  var reps = parseInt(document.getElementById('mt-reps-' + exId).textContent);
  var weightInput = document.getElementById('mt-weight-' + exId);
  var weight = (needsWeight && weightInput) ? (parseFloat(weightInput.value) || null) : null;
  if(!reps || reps < 1){ showToast('Enter at least 1 rep', 'danger'); return; }

  fetchJSON('/Skills/LogMaxTest', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ exerciseId: exId, reps: reps, weightKg: weight })
  }).then(function(d){
    if(!d || !d.success){ showToast((d && d.msg) || 'Could not save that', 'danger'); return; }
    var bestEl = document.getElementById('mt-best-' + exId);
    if(bestEl) bestEl.textContent = formatBest(d.item);
    document.getElementById('mt-test-' + exId).style.display = 'none';
    if(d.item.requirementMet){
      showToast('Requirement met for ' + d.item.skillName + '! Head to Skills to unlock it 🔓', 'success');
    } else {
      showToast('Logged — ' + reps + ' reps', 'success');
    }
  });
}

function formatBest(item){
  var parts = [];
  if(item.bestReps > 0) parts.push(item.bestReps + ' reps');
  if(item.bestWeightKg) parts.push(item.bestWeightKg + 'kg');
  return parts.length ? 'best ' + parts.join(' @ ') : 'no attempts yet';
}

function showAttempts(exId){
  var box = document.getElementById('mt-attempts-' + exId);
  if(box.style.display === 'block'){ box.style.display = 'none'; return; }
  fetchJSON('/Skills/GetAttempts?exerciseId=' + exId).then(function(d){
    if(!d || !d.success) return;
    if(d.attempts.length === 0){
      box.innerHTML = '<div class="text-muted" style="font-size:12px;padding:8px 0">No attempts logged yet</div>';
    } else {
      box.innerHTML = d.attempts.map(function(a){
        var line = a.reps + ' reps' + (a.weightKg ? ' @ ' + a.weightKg + 'kg' : '');
        return '<div style="display:flex;justify-content:space-between;padding:8px 0;border-top:1px solid var(--line);font-size:12.5px">' +
          '<span>' + line + '</span><span class="text-muted">' + a.attemptedAt + '</span></div>';
      }).join('') + '<div class="text-muted" style="font-size:11px;padding-top:6px;text-align:center">Showing last 3 attempts</div>';
    }
    box.style.display = 'block';
  });
}

if(HIGHLIGHT_ID){
  var target = document.getElementById('mt-card-' + HIGHLIGHT_ID);
  if(target){
    setTimeout(function(){
      target.scrollIntoView({behavior:'smooth', block:'center'});
      target.style.borderColor = 'var(--accent)';
      toggleTest(HIGHLIGHT_ID);
    }, 300);
  }
}
</script>
}
